# Keeps the build context small and the image free of things it
# doesn't need (or shouldn't ever contain, like real secrets).

# Local virtual environments
venv/
.venv/

# Python cruft
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Git
.git/
.gitignore

# Secrets - never bake these into an image. Real values are passed in
# at runtime instead (see docker-compose.yml / README).
.env

# Test-only files - not needed inside the container
tests/
conftest.py

# Local data
uploaded_audio/
*.db
*.db-journal

# Docs / editor cruft
README.md
DEPLOYMENT.md
LEGAL_DISCLAIMER.md
.vscode/
.idea/
