# Template for .env - copy this to .env and fill in real values.
# .env.example itself is safe to commit (no real secrets); .env is not.

# Get a free key at https://www.assemblyai.com/ (Settings -> API Keys).
# No credit card required for the free tier.
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
# Your Anthropic API key - used to write the report. Get one at
# https://console.anthropic.com/ (this is a different account/site than
# claude.ai - it's the developer/API console, and it's a paid API, billed
# per request; there's no free tier, but report generation is cheap -
# well under a cent per report with the default model).
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
API_KEY=choose-your-own-shared-secret-here

# Which Claude model writes the report. Defaults to "claude-sonnet-5"
# (see app/config.py) if left unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# Master switch: set to "false" once you want BOTH transcription and
# report generation to use real services. Defaults to "true" (see
# app/config.py) so the app works with zero API keys out of the box.
MOCK_MODE=true

# Optional per-step overrides - only set these if you want transcription
# and report generation to behave differently from each other (e.g. real
# transcription is live but report generation isn't wired up yet). Each
# defaults to whatever MOCK_MODE is above if left unset here.
# MOCK_TRANSCRIPTION=false
# MOCK_REPORT_GENERATION=true

# Same idea, for the POST /support/ask agent (see app/support_agent.py
# and the "Agent features" section of the README). Defaults to MOCK_MODE.
# MOCK_SUPPORT_AGENT=false

# Where the SQLite job database file lives. Defaults to "jobs.db" in the
# project root (see app/config.py) if left unset - only uncomment and
# set this if you want it somewhere else, e.g. a mounted volume path in
# Docker. (Leave commented out, not set to an empty value - an empty
# JOBS_DB_PATH would override the default with "", which breaks SQLite.)
# JOBS_DB_PATH=/data/jobs.db

# How many requests per client (by IP) each endpoint allows per time
# window, e.g. "5/minute". Defaults shown below (see app/config.py) if
# left unset - uncomment to change them.
# RATE_LIMIT_CREATE_SHOP=5/minute
# RATE_LIMIT_GET_SHOP=60/minute
# RATE_LIMIT_SUPPORT_AGENT=10/minute

# Caps how many tool-call round-trips the report-generation and support
# agents (see "Agent features" in the README) can each make on a single
# request, as a safety net against a runaway loop. Defaults to 8.
# AGENT_MAX_ITERATIONS=8

# When "false" (the default), the uploaded audio file is deleted once
# its job finishes - see app/consent_law.py and the "Recording consent
# compliance" section of the README before changing this.
# RETAIN_AUDIO_FILES=false
